<?xml version="1.0" encoding="utf-8"?>
<!--
  minSdk가 26이라 적응형 아이콘 하나로 끝난다(레거시 PNG 세트가 필요 없다).
  전경은 iOS와 같은 삽(BrandMark), 배경은 iOS 앱아이콘과 같은 #EEF0FF.
  전경을 25% 안쪽으로 밀어 넣는 이유는 런처가 108dp 캔버스의 바깥을 잘라내기 때문 —
  그냥 채우면 원형 런처에서 삽 손잡이와 날이 잘린다.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/brand_light" />
    <foreground>
        <inset
            android:drawable="@mipmap/ic_launcher_foreground"
            android:inset="25%" />
    </foreground>
    <!-- 안드로이드 13+ 테마 아이콘. 시스템이 알파만 쓰므로 같은 그림을 그대로 준다. -->
    <monochrome>
        <inset
            android:drawable="@mipmap/ic_launcher_foreground"
            android:inset="25%" />
    </monochrome>
</adaptive-icon>
